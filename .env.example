# Optional: eigene Azure-App (siehe docs/SETUP_AZURE.md). Leer = Microsoft Graph Command Line Tools
AZURE_TENANT_ID=
AZURE_CLIENT_ID=

# Lokale Excel-Datei (hat Vorrang vor dem Link)
PRODUCT_EXCEL_FILE=

# Privates OneDrive: Link "Jeder mit dem Link kann anzeigen" (ohne Login)
PRODUCT_EXCEL_PUBLIC_URL=

# Alternativ (Firmen-SharePoint mit Login): Freigabe-Link zur Produkt-Excel auf dem geteilten Laufwerk (SharePoint/OneDrive)
PRODUCT_EXCEL_SHARE_URL=
# Optional: Name des Tabellenblatts (leer = erstes Blatt)
PRODUCT_EXCEL_SHEET=

# Wie viele Monate Teams-Verlauf für die Stilanalyse geladen werden
CHAT_HISTORY_MONTHS=12

# Export des Blatts „Warenbestand“ als CSV (bis das Dienstkonto eingerichtet ist)
STOCK_CSV=data/warenbestand.csv

# E-Mail-Versand über IONOS (nur auf dem Server/Rechner setzen, nie committen)
MAIL_FROM=marc@neobution.com
MAIL_NAME=Marc Knieb
IONOS_SMTP_USER=
IONOS_SMTP_PASSWORD=
# Optional: fester EUR→USD-Kurs statt EZB-Tageskurs (Dubai-Liste)
USD_KURS=
