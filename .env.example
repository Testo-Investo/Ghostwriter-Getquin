# Optional: eigene Azure-App (siehe docs/SETUP_AZURE.md). Leer = Microsoft Graph Command Line Tools
AZURE_TENANT_ID=
AZURE_CLIENT_ID=

# Lokale Excel-Datei (hat Vorrang vor dem Link)
PRODUCT_EXCEL_FILE=

# Alternativ: Freigabe-Link zur Produkt-Excel auf dem geteilten Laufwerk (SharePoint/OneDrive)
PRODUCT_EXCEL_SHARE_URL=
# Optional: Name des Tabellenblatts (leer = erstes Blatt)
PRODUCT_EXCEL_SHEET=

# Wie viele Monate Teams-Verlauf für die Stilanalyse geladen werden
CHAT_HISTORY_MONTHS=12
